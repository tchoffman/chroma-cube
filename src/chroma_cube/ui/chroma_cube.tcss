#list-title, #card-title {
    padding: 0 1;
    text-style: bold;
}

#cards {
    height: 1fr;
}

#play {
    height: 1fr;
}

#left {
    width: auto;
    padding: 0 1;
}

#tray {
    width: 64;
    height: 15;
    grid-gutter: 0;
}

TrayCell {
    width: 16;
    height: 5;
    border: round #808080;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

TrayCell.empty {
    border: dashed $foreground 30%;
}

TrayCell.dark, PaletteChip.dark {
    border: round #d0d0d0;
}

TrayCell.cursor {
    border: heavy $accent;
}

TrayCell.held {
    border: double $warning;
}

TrayCell.held.cursor {
    border: double $accent;
}

.heading {
    padding: 1 0 0 0;
    text-style: bold;
}

#palette {
    height: auto;
    width: 64;
    layout: grid;
    grid-size: 4;
}

PaletteChip {
    height: 3;
    border: round #808080;
    content-align: center middle;
    text-style: bold;
}

PaletteChip.held {
    border: double $warning;
}

#clues {
    width: 1fr;
    padding: 0 1;
}

ClueRow {
    padding: 0 0 1 0;
}

ClueRow.satisfied {
    color: $success;
}

ClueRow.violated {
    color: $error;
}

ClueRow.unknown {
    color: $text-muted;
}

#message {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

WinScreen {
    align: center middle;
}

#win {
    width: 50;
    height: auto;
    padding: 1 2;
    border: thick $success;
    background: $surface;
}

#win-title {
    text-style: bold;
    color: $success;
}

#win-buttons {
    height: auto;
    padding: 1 0 0 0;
}

#win-buttons Button {
    margin: 0 1 0 0;
}
