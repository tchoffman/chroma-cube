/* Sizes come from the space available: the tray's rows and columns are set from the
   board in code, every track here is a fraction, and narrow screens stack the clues
   under the tray. */

#list-title, #card-title {
    padding: 0 1;
    text-style: bold;
}

.list-heading {
    padding: 1 1 0 1;
    text-style: bold;
}

#cards {
    height: 1fr;
}

#play {
    height: 1fr;
}

#left {
    width: 3fr;
    height: 1fr;
    padding: 0 1;
}

#tray {
    height: 1fr;
    grid-columns: 1fr;
    grid-rows: 1fr;
    grid-gutter: 0;
}

TrayCell {
    width: 1fr;
    height: 1fr;
    border: round #808080;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

TrayCell.empty {
    border: dashed $foreground 30%;
}

TrayCell.dark {
    border: round #d0d0d0;
}

TrayCell.given {
    border: double #808080;
}

TrayCell.given.dark {
    border: double #d0d0d0;
}

#tray TrayCell.held {
    border: thick $warning;
}

#tray TrayCell.hinted {
    border: thick $success;
}

#tray TrayCell.cursor {
    border: heavy $accent;
}

#tray TrayCell.held.cursor {
    border: thick $accent;
}

.heading {
    padding: 1 0 0 0;
    text-style: bold;
}

#palette {
    height: auto;
    grid-columns: 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

PaletteChip {
    width: 1fr;
    height: 1;
    content-align: center middle;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

PaletteChip.held {
    text-style: bold underline;
}

PaletteChip.hinted {
    text-style: bold reverse;
}

#clues {
    width: 2fr;
    height: 1fr;
    padding: 0 1;
}

ClueRow {
    padding: 0 0 1 0;
}

ClueRow.satisfied {
    color: $success;
}

ClueRow.violated {
    color: $error;
}

ClueRow.unknown {
    color: $text-muted;
}

ClueRow.hinted {
    text-style: bold;
    background: $success 15%;
}

/* Hint explanations run long, so the status line wraps onto up to four lines. */
#message {
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

/* Narrow screens: tray and palette on top at their smallest, clues scroll below. */

PlayScreen.-narrow #play {
    layout: vertical;
}

PlayScreen.-narrow #left {
    width: 1fr;
    height: auto;
}

PlayScreen.-narrow #tray {
    height: auto;
    grid-rows: 3;
}

PlayScreen.-narrow TrayCell {
    height: 3;
}

PlayScreen.-narrow .heading {
    padding: 0;
}

PlayScreen.-narrow #clues {
    width: 1fr;
    min-height: 3;
}

PlayScreen.-narrow ClueRow {
    padding: 0;
}

/* The shell screens: home, the card list, the infinite picker and the win dialog.
   One accent, the classic magenta cube, marks titles, the focused panel and its cursor;
   cube colors themselves appear only as cubes (the wordmark, tier badges, the win row). */

$cube-accent: #e0218a;

.shell #list-title {
    color: $cube-accent;
}

.shell OptionList {
    border: tall $cube-accent 30%;
    border-title-color: $cube-accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

.shell OptionList:focus {
    border: tall $cube-accent;
}

.shell OptionList:focus > .option-list--option-highlighted {
    color: #ffffff;
    background: $cube-accent;
    text-style: bold;
}

HomeScreen {
    align: center middle;
}

#home {
    width: 64;
    max-width: 100%;
    height: auto;
    padding: 0 1;
}

Wordmark {
    width: 100%;
    height: auto;
    content-align: center top;
}

#tagline {
    width: 100%;
    margin: 1 0;
    text-align: center;
    text-style: italic;
    color: $text-muted;
}

HomeScreen.-short #tagline {
    display: none;
}

#modes {
    height: auto;
    padding: 0 2;
}

#list-header {
    height: 1;
    padding: 0 1;
}

#list-header #list-title {
    width: 1fr;
    padding: 0;
}

#solved-count {
    color: $success;
    text-style: bold;
}

#infinite-help {
    padding: 0 1;
    color: $text-muted;
}

#pickers {
    height: auto;
    padding: 1 0 0 0;
}

#pickers OptionList {
    width: auto;
    min-width: 20;
    margin: 0 1 0 0;
}

WinScreen {
    align: center middle;
}

#win {
    width: 50;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick $cube-accent;
    background: $surface;
}

#win Label {
    width: 100%;
    text-align: center;
}

#win-title {
    text-style: bold;
    color: $cube-accent;
    margin: 1 0 0 0;
}

#win-card {
    text-style: bold;
    margin: 0 0 1 0;
}

#win-hints {
    color: $text-muted;
}

#win-cheer {
    color: $success;
    text-style: italic;
}

#win-buttons {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: center;
}

#win-buttons Button {
    margin: 0 1;
}
