/* Sizes come from the space available: the tray's rows and columns are set from the
   board in code, every track here is a fraction, and narrow screens stack the clues
   under the tray. */

#list-title {
    padding: 0 1;
    text-style: bold;
}

.list-heading {
    padding: 1 1 0 1;
    text-style: bold;
}

#cards {
    height: 1fr;
}

#play {
    height: 1fr;
}

#left {
    width: 3fr;
    height: 1fr;
    padding: 0 1;
}

#tray {
    height: 1fr;
    grid-columns: 1fr;
    grid-rows: 1fr;
    grid-gutter: 0;
}

/* Each cell draws its own well and cube (see ui/cube.py); these components give the
   frame, the well floor and its shadowed inner wall, each over the page behind the tray,
   so they work on light and dark themes. The frame turns to the state color around the
   cursor, the held cube and a hint. */
TrayCell {
    width: 1fr;
    height: 1fr;
    text-style: bold;
}

TrayCell > .tray-cell--frame {
    background: $foreground 30%;
}

TrayCell > .tray-cell--floor {
    background: black 30%;
}

TrayCell > .tray-cell--shadow {
    background: black 55%;
}

/* $warning is the same orange as $accent in the default themes, so the held ring is blue. */
#tray TrayCell.held > .tray-cell--frame {
    background: $primary;
}

#tray TrayCell.hinted > .tray-cell--frame {
    background: $success;
}

#tray TrayCell.cursor > .tray-cell--frame {
    background: $accent;
}

.heading {
    padding: 1 0 0 0;
    text-style: bold;
}

#palette {
    height: auto;
    grid-columns: 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

PaletteChip {
    width: 1fr;
    height: 1;
    text-style: bold;
}

PaletteChip.held {
    text-style: bold underline;
}

/* A hinted chip's strips turn the hint green, like the hinted cell's frame. */
PaletteChip > .palette-chip--hint {
    background: $success;
}

/* The clue card: the card's name in the top edge, its tier and clue count in the bottom
   edge, numbered clues with a marker gutter, and the note at the foot. */

#card {
    width: 2fr;
    height: 1fr;
    border: round $foreground 50%;
    border-title-style: bold;
    border-title-color: $foreground;
    border-subtitle-color: $text-muted;
    background: $boost;
}

#clues {
    height: 1fr;
    padding: 0 2 0 1;
    scrollbar-size-vertical: 1;
}

ClueRow {
    margin: 0 0 1 0;
}

ClueRow.satisfied {
    color: $foreground 45%;
}

ClueRow.violated {
    color: $error;
    text-style: bold;
    background: $error 15%;
}

ClueRow.hinted {
    text-style: bold;
    background: $success 15%;
}

#card-note {
    border-top: dashed $foreground 30%;
    color: $text-muted;
    text-style: italic;
}

/* Hint explanations run long, so the status line wraps onto up to four lines. */
#message {
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

/* Narrow screens: tray and palette on top at their smallest, clues scroll below. */

PlayScreen.-narrow #play {
    layout: vertical;
}

PlayScreen.-narrow #left {
    width: 1fr;
    height: auto;
}

PlayScreen.-narrow #tray {
    height: auto;
    grid-rows: 3;
}

PlayScreen.-narrow TrayCell {
    height: 3;
}

PlayScreen.-narrow .heading {
    padding: 0;
}

PlayScreen.-narrow #card {
    width: 1fr;
    min-height: 5;
}

PlayScreen.-narrow ClueRow {
    margin: 0;
}

/* The shell screens: home, the card list, the infinite picker and the win dialog.
   One accent, the classic magenta cube, marks titles, the focused panel and its cursor;
   cube colors themselves appear only as cubes (the wordmark, tier badges, the win row). */

$cube-accent: #e0218a;

.shell #list-title {
    color: $cube-accent;
}

.shell OptionList {
    border: tall $cube-accent 30%;
    border-title-color: $cube-accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

.shell OptionList:focus {
    border: tall $cube-accent;
}

.shell OptionList:focus > .option-list--option-highlighted {
    color: #ffffff;
    background: $cube-accent;
    text-style: bold;
}

HomeScreen {
    align: center middle;
}

#home {
    width: 64;
    max-width: 100%;
    height: auto;
    padding: 0 1;
}

Wordmark {
    width: 100%;
    height: auto;
    content-align: center top;
}

#tagline {
    width: 100%;
    margin: 1 0;
    text-align: center;
    text-style: italic;
    color: $text-muted;
}

HomeScreen.-short #tagline {
    display: none;
}

#modes {
    height: auto;
    padding: 0 2;
}

#list-header {
    height: 1;
    padding: 0 1;
}

#list-header #list-title {
    width: 1fr;
    padding: 0;
}

#solved-count {
    color: $success;
    text-style: bold;
}

#infinite-help {
    padding: 0 1;
    color: $text-muted;
}

#pickers {
    height: auto;
    padding: 1 0 0 0;
}

#pickers OptionList {
    width: auto;
    min-width: 20;
    margin: 0 1 0 0;
}

WinScreen {
    align: center middle;
}

#win {
    width: 50;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick $cube-accent;
    background: $surface;
}

#win Label {
    width: 100%;
    text-align: center;
}

#win-title {
    text-style: bold;
    color: $cube-accent;
    margin: 1 0 0 0;
}

#win-card {
    text-style: bold;
    margin: 0 0 1 0;
}

#win-hints {
    color: $text-muted;
}

#win-cheer {
    color: $success;
    text-style: italic;
}

#win-buttons {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: center;
}

#win-buttons Button {
    margin: 0 1;
}
