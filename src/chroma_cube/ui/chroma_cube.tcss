/* Sizes come from the space available: the tray's rows and columns are set from the
   board in code, every track here is a fraction, and narrow screens stack the clues
   under the tray. */

#list-title, #card-title {
    padding: 0 1;
    text-style: bold;
}

.list-heading {
    padding: 1 1 0 1;
    text-style: bold;
}

#cards {
    height: 1fr;
}

#play {
    height: 1fr;
}

#left {
    width: 3fr;
    height: 1fr;
    padding: 0 1;
}

#tray {
    height: 1fr;
    grid-columns: 1fr;
    grid-rows: 1fr;
    grid-gutter: 0;
}

/* Each cell draws its own well and cube (see ui/cube.py); these components give the
   frame, the well floor and its shadowed inner wall, each over the page behind the tray,
   so they work on light and dark themes. The frame turns to the state color around the
   cursor, the held cube and a hint. */
TrayCell {
    width: 1fr;
    height: 1fr;
    text-style: bold;
}

TrayCell > .tray-cell--frame {
    background: $foreground 30%;
}

TrayCell > .tray-cell--floor {
    background: black 20%;
}

TrayCell > .tray-cell--shadow {
    background: black 55%;
}

/* $warning is the same orange as $accent in the default themes, so the held ring is blue. */
#tray TrayCell.held > .tray-cell--frame {
    background: $primary;
}

#tray TrayCell.hinted > .tray-cell--frame {
    background: $success;
}

#tray TrayCell.cursor > .tray-cell--frame {
    background: $accent;
}

.heading {
    padding: 1 0 0 0;
    text-style: bold;
}

#palette {
    height: auto;
    grid-columns: 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

PaletteChip {
    width: 1fr;
    height: 1;
    text-style: bold;
}

PaletteChip.held {
    text-style: bold underline;
}

PaletteChip.hinted {
    text-style: bold reverse;
}

#clues {
    width: 2fr;
    height: 1fr;
    padding: 0 1;
}

ClueRow {
    padding: 0 0 1 0;
}

ClueRow.satisfied {
    color: $success;
}

ClueRow.violated {
    color: $error;
}

ClueRow.unknown {
    color: $text-muted;
}

ClueRow.hinted {
    text-style: bold;
    background: $success 15%;
}

/* Hint explanations run long, so the status line wraps onto up to four lines. */
#message {
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

/* Narrow screens: tray and palette on top at their smallest, clues scroll below. */

PlayScreen.-narrow #play {
    layout: vertical;
}

PlayScreen.-narrow #left {
    width: 1fr;
    height: auto;
}

PlayScreen.-narrow #tray {
    height: auto;
    grid-rows: 3;
}

PlayScreen.-narrow TrayCell {
    height: 3;
}

PlayScreen.-narrow .heading {
    padding: 0;
}

PlayScreen.-narrow #clues {
    width: 1fr;
    min-height: 3;
}

PlayScreen.-narrow ClueRow {
    padding: 0;
}

WinScreen {
    align: center middle;
}

#win {
    width: 50;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick $success;
    background: $surface;
}

#win-title {
    text-style: bold;
    color: $success;
}

#win-buttons {
    height: auto;
    padding: 1 0 0 0;
}

#win-buttons Button {
    margin: 0 1 0 0;
}
